  "views": [
    { "name": "Created", "query": "is:open author:@me" },
    { "name": "Review requests", "query": "is:open review-requested:@me" },
    { "name": "Code review", "plugin": "slack", "list": "code-review", "query": "recent:24h" },
    { "name": "Assigned", "query": "is:open assignee:@me" },
    { "name": "Mentioned", "query": "is:open mentions:@me" }
  ],
  "plugins": [
    { "name": "slack", "command": ["python3", "@DIR@/demo.py", "plugin"], "rerun": "exit" }
  ]
}
